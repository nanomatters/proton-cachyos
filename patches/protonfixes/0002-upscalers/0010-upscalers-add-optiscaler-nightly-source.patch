@@ -0,0 +1,289 @@
+"""Verified, on-demand extraction of official OptiScaler nightlies."""
+
+import configparser
+import hashlib
+import json
+import os
+import platform
+import re
+import shutil
+import subprocess
+import tarfile
+import tempfile
+import urllib.request
+from pathlib import Path, PurePosixPath
+
+from .logger import log
+
+
+ROOT = 'drive_c/windows/system32/umu'
+ALIASES = ('dxgi.dll', 'd3d12.dll', 'winmm.dll', 'dbghelp.dll')
+REPOSITORY = 'optiscaler/OptiScaler-nightly'
+SEVENZIP_VERSION = '26.03'
+SEVENZIP_BUILDS = {
+    'x86_64': ('x64', 'dc99eff5008f1ab79bd7084c68513701547a808a89502bf4133683535ab3c695'),
+    'aarch64': ('arm64', '2389ba20e4d8295e8709c20b6263b69bd1ec4972fe38a04ad7a1badbf595b996'),
+}
+# Match the stable Proton package's launcher/crash-handler exclusions.
+EXCLUDED_PROCESSES = (
+    'crashpad_handler.exe', 'crashreport.exe', 'crashreporter.exe', 'crs-handler.exe',
+    'unitycrashhandler64.exe', 'idtechlauncher.exe', 'cefviewwing.exe', 'ace-setup64.exe',
+    'ace-service64.exe', 'qtwebengineprocess.exe', 'platformprocess.exe', 'bugsplathd64.exe',
+    'bssndrpt64.exe', 'pspcsdkappmgr.exe', 'pspcsdkcore.exe', 'pspcsdkstttts.exe',
+    'pspcsdktelemetry.exe', 'pspcsdkui.exe', 'pspcsdkupdatechecker.exe',
+    'pspcsdkvoicechat.exe', 'pspcsdkwebview.exe', 'windhawk.exe', 'vscodium.exe',
+    'crash_reporter.exe', 'steamerrorreporter64.exe', 'crashreportclient.exe',
+    'edcefcrashpadprocess.exe', 'edcefrenderprocess.exe',
+    'EOSOverlayRenderer-Win64-Shipping.exe', 'EOSOverlayRenderer-Win32-Shipping.exe',
+)
+
+
+def is_nightly(version):
+    return version == 'nightly' or version.startswith('nightly-')
+
+
+def file_hash(path, algorithm='sha256'):
+    digest = hashlib.new(algorithm)
+    with Path(path).open('rb') as source:
+        for block in iter(lambda: source.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_write(path, data, mode=0o600):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
+        temporary = Path(output.name)
+        try:
+            output.write(data)
+            output.flush()
+            os.fchmod(output.fileno(), mode)
+            os.replace(temporary, path)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+
+def verified_download(url, path, checksum):
+    """Publish only complete downloads; a failed refresh leaves the cache intact."""
+    path = Path(path)
+    if path.is_file() and file_hash(path) == checksum:
+        return path
+    path.parent.mkdir(parents=True, exist_ok=True)
+    request = urllib.request.Request(url, headers={'User-Agent': 'Proton-OptiScaler'})
+    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
+        temporary = Path(output.name)
+        try:
+            with urllib.request.urlopen(request, timeout=15) as response:
+                shutil.copyfileobj(response, output)
+            output.flush()
+            if file_hash(temporary) != checksum:
+                raise ValueError(f'SHA-256 mismatch for {url}')
+            os.replace(temporary, path)
+        finally:
+            temporary.unlink(missing_ok=True)
+    return path
+
+
+def _release_item(release, version):
+    tag = release['tag_name']
+    if (not re.fullmatch(r'nightly-\d{8}', tag) or release.get('draft')
+            or (version != 'nightly' and tag != version)):
+        raise ValueError('Nightly release does not match the requested tag')
+    assets = [asset for asset in release['assets']
+              if re.fullmatch(r'OptiScaler[^/\\]*\.7z', asset['name'])]
+    if len(assets) != 1:
+        raise ValueError('Expected one OptiScaler nightly .7z asset')
+    asset = assets[0]
+    digest = asset.get('digest', '')
+    if not re.fullmatch(r'sha256:[0-9a-f]{64}', digest):
+        raise ValueError('Nightly asset has no SHA-256 digest')
+    url = f'https://github.com/{REPOSITORY}/releases/download/{tag}/{asset["name"]}'
+    if asset['browser_download_url'] != url:
+        raise ValueError('Unexpected nightly asset URL')
+    return {'version': tag, 'download_url': url, 'sha256': digest[7:]}
+
+
+def resolve(version, cache):
+    """Resolve once per setup, including prereleases; exact tags never float."""
+    if version != 'nightly' and not re.fullmatch(r'nightly-\d{8}', version):
+        raise ValueError(f'Invalid OptiScaler nightly selection: {version}')
+    metadata = Path(cache) / 'nightly' / f'{version}.json'
+    endpoint = 'releases?per_page=100' if version == 'nightly' else f'releases/tags/{version}'
+    request = urllib.request.Request(
+        f'https://api.github.com/repos/{REPOSITORY}/{endpoint}',
+        headers={'User-Agent': 'Proton-OptiScaler', 'Accept': 'application/vnd.github+json'},
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=10) as response:
+            data = json.load(response)
+        if version == 'nightly':
+            releases = [entry for entry in data if not entry.get('draft')
+                        and re.fullmatch(r'nightly-\d{8}', entry.get('tag_name', ''))]
+            data = max(releases, key=lambda entry: entry['tag_name'])
+        item = _release_item(data, version)
+    except Exception as error:
+        log.warn(f'Cannot resolve OptiScaler {version}: {error}')
+        # Cached metadata is revalidated, and may only satisfy the same selection.
+        return _release_item(json.loads(metadata.read_text(encoding='utf-8')), version)
+    atomic_write(metadata, json.dumps(data).encode('utf-8'))
+    return item
+
+
+def extractor(cache):
+    """Use the official static host binary, independent of the game's bitness."""
+    arch, checksum = SEVENZIP_BUILDS[platform.machine()]
+    directory = Path(cache) / '7zip' / SEVENZIP_VERSION / arch
+    name = f'7z{SEVENZIP_VERSION.replace(".", "")}-linux-{arch}.tar.xz'
+    archive = verified_download(
+        f'https://github.com/ip7z/7zip/releases/download/{SEVENZIP_VERSION}/{name}',
+        directory / name, checksum,
+    )
+    # Read exact regular members, retaining the upstream notices alongside 7zzs.
+    # Compare with the verified archive before ever executing a cached binary.
+    with tarfile.open(archive, 'r:xz') as source:
+        for name in ('7zzs', 'License.txt', 'readme.txt', 'MANUAL/general/license.htm'):
+            member = source.getmember(name)
+            if not member.isfile():
+                raise ValueError(f'Unexpected 7-Zip member: {name}')
+            data = source.extractfile(member).read()
+            target = directory / name
+            if not target.is_file() or target.read_bytes() != data:
+                atomic_write(target, data, 0o700 if name == '7zzs' else 0o600)
+    return directory / '7zzs'
+
+
+def safe_name(name):
+    path = PurePosixPath(name)
+    if (not name or path.is_absolute() or '..' in path.parts
+            or '\\' in name or ':' in name or str(path) != name):
+        raise ValueError(f'Unsafe OptiScaler archive path: {name!r}')
+    return path
+
+
+def prepare(item, cache, stage):
+    """Extract the nightly without running its setup scripts or flattening DLLs."""
+    stage = Path(stage)
+    archive = verified_download(item['download_url'],
+                                Path(cache) / 'nightly' / (item['sha256'] + '.7z'),
+                                item['sha256'])
+    command = [str(extractor(cache))]
+    result = subprocess.run(command + ['l', '-slt', '-ba', str(archive)],
+                            check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            stdin=subprocess.DEVNULL, text=True, timeout=120)
+    for entry in result.stdout.strip().split('\n\n'):
+        fields = dict(line.split(' = ', 1) for line in entry.splitlines() if ' = ' in line)
+        safe_name(fields['Path'])
+        if ('Symbolic Link' in fields or 'Hard Link' in fields
+                or re.search(r'(^| )l[rwx-]{9}', fields.get('Attributes', ''))):
+            raise ValueError('Links are not allowed in nightly archives')
+    subprocess.run(command + ['x', '-y', '-o' + str(stage), str(archive)],
+                   check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                   stdin=subprocess.DEVNULL, timeout=120)
+    # Only install runtime files and notices. The rest stays in the temporary tree.
+    files = []
+    for path in stage.rglob('*'):
+        if path.is_symlink():
+            raise ValueError('Links are not allowed in nightly archives')
+        if not path.is_file():
+            continue
+        name = path.relative_to(stage).as_posix()
+        if (name in ('OptiScaler.dll', 'OptiScaler.ini', 'fakenvapi.dll', 'fakenvapi.ini',
+                     'dlssg_to_fsr3_amd_is_better.dll')
+                or name.startswith('Licenses/')
+                or (name.startswith('OptiScaler/') and path.suffix.lower() == '.dll')):
+            files.append(name)
+    for alias in ALIASES:
+        (stage / alias).symlink_to('OptiScaler.dll')
+        files.append(alias)
+    ini = stage / 'OptiScaler.ini'
+    parser = configparser.ConfigParser(interpolation=None)
+    parser.optionxform = str
+    parser.read(ini, encoding='utf-8-sig')
+    library_path = r'c:\windows\system32\umu'
+    parser['Libraries']['OptiDllPath'] = library_path + r'\OptiScaler'
+    parser['Libraries']['NvngxDlssPath'] = library_path
+    parser['Libraries']['NvngxFeaturePath'] = library_path
+    if (stage / 'fakenvapi.dll').is_file():
+        parser['Libraries']['NvapiPath'] = library_path + r'\fakenvapi.dll'
+    parser['Hotfix']['CheckForUpdate'] = 'false'
+    parser['ProcessFilter']['ProcessExclusionList'] = '|'.join(EXCLUDED_PROCESSES)
+    if parser.has_option('FSR', 'Fsr4Update'):
+        parser['FSR']['Fsr4Update'] = 'true'
+    with ini.open('w', encoding='utf-8') as output:
+        parser.write(output)
+    if not (stage / 'OptiScaler.dll').is_file():
+        raise ValueError('Nightly archive has no OptiScaler.dll')
+    return {name: None if name.lower().endswith('.ini') else file_hash(stage / name, 'md5')
+            for name in files}
+
+
+def prepare_stable(archive, hashes, stage):
+    """Keep stable's unhashed INIs/plugins too, validating local DLL aliases."""
+    stage = Path(stage)
+    files = {}
+    with tarfile.open(archive, 'r:xz') as source:
+        for member in source:
+            name = member.name
+            safe_name(name)
+            target = stage / name
+            if member.isdir():
+                target.mkdir(parents=True, exist_ok=True)
+                continue
+            target.parent.mkdir(parents=True, exist_ok=True)
+            if member.isfile():
+                with source.extractfile(member) as data, target.open('wb') as output:
+                    shutil.copyfileobj(data, output)
+            elif (member.issym() and name in ALIASES and member.linkname == 'OptiScaler.dll'):
+                target.symlink_to(member.linkname)
+            else:
+                raise ValueError(f'Unexpected stable archive member: {name}')
+            files[name] = hashes.get(name)
+    for name, checksum in hashes.items():
+        if checksum and file_hash(stage / name, 'md5') != checksum.lower():
+            raise ValueError(f'MD5 mismatch for {name}')
+    if any(name not in files for name in hashes):
+        raise ValueError('Stable archive is missing manifest entries')
+    return files
+
+
+def install(stage, destination, old_names, new_names, commit):
+    """Replace owned files with rollback on failure, including metadata failure."""
+    stage, destination = Path(stage), Path(destination)
+    names = sorted(set(old_names) | set(new_names))
+    for name in names:
+        safe_name(name)
+        # Do not follow a directory symlink out of the package's installation root.
+        parent = destination / name
+        while parent != destination:
+            parent = parent.parent
+            if parent.is_symlink():
+                raise ValueError(f'Symlink in installation path: {parent}')
+        target = destination / name
+        if target.is_dir() and not target.is_symlink():
+            raise ValueError(f'Directory at package file path: {target}')
+        if name in new_names and name not in old_names and os.path.lexists(target):
+            raise ValueError(f'Refusing to overwrite an untracked file: {target}')
+    moved, installed = [], []
+    with tempfile.TemporaryDirectory(prefix='.optiscaler-backup-', dir=destination.parent) as tmp:
+        backup = Path(tmp)
+        try:
+            for name in names:
+                target = destination / name
+                if os.path.lexists(target):
+                    saved = backup / name
+                    saved.parent.mkdir(parents=True, exist_ok=True)
+                    os.replace(target, saved)
+                    moved.append(name)
+            for name in new_names:
+                target = destination / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                os.replace(stage / name, target)
+                installed.append(name)
+            commit()
+        except Exception:
+            for name in reversed(installed):
+                (destination / name).unlink()
+            for name in reversed(moved):
+                os.replace(backup / name, destination / name)
+            raise
